include(cmake/Dependencies.cmake)
oc2_fetch_dependency(SQLite)
string(JSON oc2_sqlite_version GET "${oc2_dependency_lock}" libraries SQLite version)
file(STRINGS "${sqlite_SOURCE_DIR}/sqlite3.h" oc2_sqlite_version_line
  REGEX "^#define SQLITE_VERSION +\"")
if(NOT oc2_sqlite_version_line MATCHES "\"${oc2_sqlite_version}\"$")
  message(FATAL_ERROR "SQLite source override does not match pinned ${oc2_sqlite_version}")
endif()
add_library(oc2_sqlite STATIC "${sqlite_SOURCE_DIR}/sqlite3.c")
target_include_directories(oc2_sqlite SYSTEM PUBLIC "${sqlite_SOURCE_DIR}")
target_compile_definitions(oc2_sqlite PRIVATE SQLITE_OMIT_LOAD_EXTENSION SQLITE_THREADSAFE=1)
find_package(Threads REQUIRED)
target_link_libraries(oc2_sqlite PRIVATE Threads::Threads)
