# Data dependency only. Headless builds never include this file or fetch fonts.
include(cmake/Dependencies.cmake)
oc2_fetch_dependency(DejaVu)
set(oc2_font_manifest "${PROJECT_SOURCE_DIR}/docs/content/fonts.json")
file(READ "${oc2_font_manifest}" oc2_font_json)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${oc2_font_manifest}")
string(JSON oc2_font_count LENGTH "${oc2_font_json}" faces)
math(EXPR oc2_font_last "${oc2_font_count} - 1")
set(oc2_font_cpp "// Generated TrueType bytes; no build-time rasterization.\n#include \"ui/font_data.hpp\"\nnamespace openciv::ui {\nnamespace {\n")
set(oc2_font_entries "")
string(REPEAT "[0-9a-f]" 64 oc2_font_line)
foreach(index RANGE 0 ${oc2_font_last})
  foreach(field id name file size sha256)
    string(JSON oc2_font_${field} GET "${oc2_font_json}" faces ${index} ${field})
  endforeach()
  set(oc2_font_path "${dejavu_SOURCE_DIR}/${oc2_font_file}")
  if(NOT EXISTS "${oc2_font_path}")
    message(FATAL_ERROR "Missing pinned TrueType font: ${oc2_font_path}")
  endif()
  file(SHA256 "${oc2_font_path}" oc2_font_hash)
  file(SIZE "${oc2_font_path}" oc2_font_bytes)
  if(NOT oc2_font_hash STREQUAL oc2_font_sha256 OR NOT oc2_font_bytes EQUAL oc2_font_size)
    message(FATAL_ERROR "TrueType font differs from content pin: ${oc2_font_file}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${oc2_font_path}")
  file(READ "${oc2_font_path}" oc2_font_hex HEX)
  # Short generated lines also work with MSVC; no Python/code-generator dependency.
  string(REGEX REPLACE "(${oc2_font_line})" "\\1\n" oc2_font_hex "${oc2_font_hex}")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," oc2_font_hex "${oc2_font_hex}")
  string(APPEND oc2_font_cpp "const unsigned char font_${index}[] = {\n${oc2_font_hex}\n};\n")
  string(APPEND oc2_font_entries "{\"${oc2_font_id}\", \"${oc2_font_name}\", font_${index}},\n")
endforeach()
string(APPEND oc2_font_cpp "const FontSource sources[] = {\n${oc2_font_entries}};\n}\nstd::span<const FontSource> font_sources() { return sources; }\n}\n")
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/font_data.cpp" CONTENT "${oc2_font_cpp}" @ONLY)
add_library(oc2_font_data STATIC "${PROJECT_BINARY_DIR}/font_data.cpp")
target_include_directories(oc2_font_data PRIVATE "${PROJECT_SOURCE_DIR}/src")
target_compile_features(oc2_font_data PRIVATE cxx_std_20)

string(JSON oc2_font_license_file GET "${oc2_font_json}" license file)
string(JSON oc2_font_license_hash GET "${oc2_font_json}" license sha256)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${dejavu_SOURCE_DIR}/${oc2_font_license_file}")
file(SHA256 "${dejavu_SOURCE_DIR}/${oc2_font_license_file}" oc2_actual_license_hash)
if(NOT oc2_actual_license_hash STREQUAL oc2_font_license_hash)
  message(FATAL_ERROR "DejaVu license differs from content pin")
endif()
file(READ "${dejavu_SOURCE_DIR}/${oc2_font_license_file}" oc2_font_license)
file(READ "${PROJECT_SOURCE_DIR}/THIRD_PARTY_NOTICES.txt" oc2_notices)
file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/THIRD_PARTY_NOTICES.txt"
  CONTENT "${oc2_notices}\nDejaVu TrueType fonts 2.37\nhttps://dejavu-fonts.github.io/\n\n${oc2_font_license}" @ONLY)
