#!/bin/sh
# Check the index without rewriting files or disturbing partial staging.
if command -v python3 >/dev/null 2>&1; then
    exec python3 tools/format.py --staged
elif command -v python >/dev/null 2>&1; then
    exec python tools/format.py --staged
else
    echo "Formatting check requires Python 3.9+; see docs/BUILDING.md." >&2
    exit 1
fi
