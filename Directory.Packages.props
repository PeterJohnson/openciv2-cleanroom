<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Browser" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.6" />

    <!-- Keep Avalonia's managed/native graphics dependencies aligned on every
         host, including .NET 11's Emscripten 6.0.2 browser assets. -->
    <PackageVersion Include="SkiaSharp" Version="4.156.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.156.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="4.156.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.WebAssembly" Version="4.156.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.156.1" />
    <PackageVersion Include="HarfBuzzSharp" Version="14.4.0.101" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.4.0.101" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.macOS" Version="14.4.0.101" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.WebAssembly" Version="14.4.0.101" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Win32" Version="14.4.0.101" />

    <PackageVersion Include="RandN.Pcg32" Version="0.5.0" />
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.3" />
  </ItemGroup>
</Project>
