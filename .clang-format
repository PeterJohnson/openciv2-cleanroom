# Use the clang-format version pinned in dependencies.json.
BasedOnStyle: LLVM
# clang-format 20 has no c++23 selector; Latest enables its current grammar.
Standard: Latest
IndentWidth: 4
ContinuationIndentWidth: 4
AccessModifierOffset: -4
ColumnLimit: 100
BreakBeforeBraces: Attach
PointerAlignment: Left
DerivePointerAlignment: false
NamespaceIndentation: None
# Keep required C/C++ ABI linkage blocks flat.
IndentExternBlock: NoIndent
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
# SDL entry-point and platform headers have intentional include ordering.
SortIncludes: Never
IncludeBlocks: Preserve
LineEnding: LF
