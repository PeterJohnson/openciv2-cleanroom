# Run from the repository root: doxygen Doxyfile
# Documentation is optional; ordinary builds do not require Doxygen.
PROJECT_NAME           = "OpenCiv2 cleanroom"
PROJECT_BRIEF          = "Portable game foundations and application interfaces"
OUTPUT_DIRECTORY       = build/api-docs
INPUT                  = docs/code-guide.md src
USE_MDFILE_AS_MAINPAGE  = docs/code-guide.md
RECURSIVE              = YES
FILE_PATTERNS          = *.cppm *.cpp *.h *.m *.mm *.md
EXTENSION_MAPPING      = cppm=C++
OPTIMIZE_OUTPUT_FOR_C   = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_FROM_PATH        = .
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_LOGFILE           = build/api-docs/warnings.log
