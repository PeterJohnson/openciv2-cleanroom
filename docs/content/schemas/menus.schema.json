{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openciv2.invalid/schemas/content/v1/menus.schema.json",
  "title": "Semantic menu action trees",
  "description": "Version 1 draft. Structural validation only; the content contract also requires semantic and cross-file checks.",
  "type": "object",
  "properties": {
    "format": {
      "const": "openciv2-menus/1"
    },
    "locale": {
      "$ref": "common.schema.json#/$defs/locale"
    },
    "menus": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/item"
            }
          }
        },
        "required": [
          "id",
          "label",
          "items"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "format",
    "locale",
    "menus"
  ],
  "additionalProperties": false,
  "$defs": {
    "item": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "kind": {
              "const": "action"
            },
            "action": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "label": {
              "$ref": "common.schema.json#/$defs/id"
            }
          },
          "required": [
            "id",
            "kind",
            "action",
            "label"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "kind": {
              "const": "submenu"
            },
            "label": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item"
              }
            }
          },
          "required": [
            "id",
            "kind",
            "label",
            "items"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "kind": {
              "const": "separator"
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
