{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openciv2.invalid/schemas/content/v1/classic-compatibility.schema.json",
  "title": "Classic content compatibility descriptor",
  "description": "Version 1 draft. Structural validation only; the content contract also requires semantic and cross-file checks.",
  "type": "object",
  "properties": {
    "format": {
      "const": "openciv2-classic-compatibility/1"
    },
    "profile": {
      "const": "classic-mge-5.4.0f"
    },
    "encoding": {
      "const": "windows-1252"
    },
    "ruleSlots": {
      "type": "object",
      "properties": {
        "advances": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 99
              }
            },
            "required": [
              "id",
              "slot"
            ],
            "additionalProperties": false
          }
        },
        "improvements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 66
              }
            },
            "required": [
              "id",
              "slot"
            ],
            "additionalProperties": false
          }
        },
        "units": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 61
              }
            },
            "required": [
              "id",
              "slot"
            ],
            "additionalProperties": false
          }
        },
        "terrain": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32
              }
            },
            "required": [
              "id",
              "slot"
            ],
            "additionalProperties": false
          }
        },
        "governments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 6
              }
            },
            "required": [
              "id",
              "slot"
            ],
            "additionalProperties": false
          }
        },
        "tribes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 20
              }
            },
            "required": [
              "id",
              "slot"
            ],
            "additionalProperties": false
          }
        },
        "commodities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              }
            },
            "required": [
              "id",
              "slot"
            ],
            "additionalProperties": false
          }
        },
        "orders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "slot": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              }
            },
            "required": [
              "id",
              "slot"
            ],
            "additionalProperties": false
          }
        },
        "difficulties": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 5
              }
            },
            "required": [
              "id",
              "slot"
            ],
            "additionalProperties": false
          }
        },
        "diplomaticAttitudes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "slot": {
                "type": "integer",
                "minimum": 0,
                "maximum": 8
              }
            },
            "required": [
              "id",
              "slot"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "textLookups": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "source": {
              "type": "object",
              "properties": {
                "resource": {
                  "$ref": "common.schema.json#/$defs/resourceStem"
                },
                "section": {
                  "$ref": "common.schema.json#/$defs/text"
                },
                "index": {
                  "$ref": "common.schema.json#/$defs/nonnegativeInteger"
                }
              },
              "required": [
                "resource",
                "section"
              ],
              "additionalProperties": false
            },
            "target": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "label",
                    "message",
                    "help",
                    "fact"
                  ]
                },
                "id": {
                  "$ref": "common.schema.json#/$defs/id"
                }
              },
              "required": [
                "kind",
                "id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "source",
            "target"
          ],
          "additionalProperties": false
        }
      },
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/locale"
      }
    },
    "scenarioFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "$ref": "common.schema.json#/$defs/worldFilename"
          },
          "scenario": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "required": [
          "file",
          "scenario"
        ],
        "additionalProperties": false
      }
    },
    "scenarioResources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scenario": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "locale": {
            "$ref": "common.schema.json#/$defs/locale"
          },
          "presentResources": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/resourceStem"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "scenario",
          "locale",
          "presentResources"
        ],
        "additionalProperties": false
      }
    },
    "retainedUnitFlags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "positions": {
            "type": "array",
            "items": {
              "const": 15
            },
            "uniqueItems": true
          }
        },
        "required": [
          "unit",
          "positions"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "format",
    "profile",
    "encoding",
    "ruleSlots",
    "textLookups",
    "scenarioFiles",
    "scenarioResources",
    "retainedUnitFlags"
  ],
  "additionalProperties": false
}
