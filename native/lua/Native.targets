<Project>
  <PropertyGroup>
    <Oc2Python Condition="'$(Oc2Python)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">python</Oc2Python>
    <Oc2Python Condition="'$(Oc2Python)' == ''">python3</Oc2Python>
    <Oc2LuaDirectory Condition="'$(Oc2LuaDirectory)' == ''">$(MSBuildThisFileDirectory)../../build/lua/native</Oc2LuaDirectory>
    <Oc2LuaLibrary Condition="$([MSBuild]::IsOSPlatform('Windows'))">oc2_lua.dll</Oc2LuaLibrary>
    <Oc2LuaLibrary Condition="$([MSBuild]::IsOSPlatform('OSX'))">liboc2_lua.dylib</Oc2LuaLibrary>
    <Oc2LuaLibrary Condition="$([MSBuild]::IsOSPlatform('Linux'))">liboc2_lua.so</Oc2LuaLibrary>
    <Oc2LuaBuildTool>$(MSBuildThisFileDirectory)../../tools/dotnet/build_lua.py</Oc2LuaBuildTool>
  </PropertyGroup>
  <ItemGroup>
    <_Oc2IdentityInput Include="$(MSBuildThisFileFullPath);$(Oc2LuaBuildTool);$(Oc2LuaDirectory)/oc2-lua-build.json" />
    <Content Include="$(Oc2LuaDirectory)/$(Oc2LuaLibrary)" Link="$(Oc2LuaLibrary)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(Oc2LuaDirectory)/oc2-lua-build.json" Link="oc2-lua-build.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(Oc2LuaDirectory)/LUA-NOTICE.txt" Link="LUA-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequirePinnedLua" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(Oc2LuaDirectory)/$(Oc2LuaLibrary)')" Text="Build the optional native dependency first: python tools/dotnet/build_lua.py" />
    <Exec Command="&quot;$(Oc2Python)&quot; &quot;$(Oc2LuaBuildTool)&quot; --verify --output &quot;$(Oc2LuaDirectory)&quot;" />
  </Target>
</Project>
