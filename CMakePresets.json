{
  "version": 5,
  "configurePresets": [
    {
      "name": "desktop",
      "displayName": "Desktop, offline dependencies",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "desktop-fetch",
      "displayName": "Desktop, allow pinned dependency downloads",
      "inherits": "desktop",
      "cacheVariables": {
        "OC2_FETCH_DEPENDENCIES": "ON",
        "OC2_FETCH_SDL": "ON"
      }
    },
    {
      "name": "gui-tests",
      "inherits": "desktop-fetch",
      "cacheVariables": {
        "OC2_GUI_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "desktop",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "headless",
      "inherits": "desktop",
      "cacheVariables": {
        "OC2_BUILD_GUI": "OFF"
      }
    },
    {
      "name": "headless-fetch",
      "inherits": "headless",
      "cacheVariables": {
        "OC2_FETCH_DEPENDENCIES": "ON"
      }
    },
    {
      "name": "sanitize",
      "inherits": "headless",
      "cacheVariables": {
        "OC2_SANITIZERS": "ON"
      }
    },
    {
      "name": "web",
      "inherits": "desktop-fetch",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-fexceptions"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop"
    },
    {
      "name": "desktop-fetch",
      "configurePreset": "desktop-fetch"
    },
    {
      "name": "gui-tests",
      "configurePreset": "gui-tests"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "headless",
      "configurePreset": "headless"
    },
    {
      "name": "headless-fetch",
      "configurePreset": "headless-fetch"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    },
    {
      "name": "web",
      "configurePreset": "web"
    }
  ],
  "testPresets": [
    {
      "name": "desktop",
      "configurePreset": "desktop",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "desktop-fetch",
      "configurePreset": "desktop-fetch",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "gui-tests",
      "configurePreset": "gui-tests",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless",
      "configurePreset": "headless",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "headless-fetch",
      "configurePreset": "headless-fetch",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "web",
      "configurePreset": "web",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
