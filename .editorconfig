root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{json,props,csproj,slnx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true

# Keep production control flow readable even when a body has only one statement.
# The line length is an editor guide; dotnet format does not wrap expressions.
[src/**/*.cs]
max_line_length = 120
csharp_prefer_braces = true:warning
# Preserve compact auto-properties; implementation bodies use expanded blocks.
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false
