<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.15</RuntimeFrameworkVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Packaging is opt-in. Keep runtime-specific restore graphs separate from
       ordinary development locks; the packager admits only its supported RID. -->
  <PropertyGroup Condition="'$(Oc2PackageRid)' != ''">
    <RuntimeIdentifier>$(Oc2PackageRid)</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)packaging/locks/$(Oc2PackageRid)/$(MSBuildProjectName).json</NuGetLockFilePath>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
</Project>
