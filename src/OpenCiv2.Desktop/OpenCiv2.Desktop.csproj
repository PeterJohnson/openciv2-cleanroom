<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType></PropertyGroup>
  <PropertyGroup>
    <Oc2AudioDirectory Condition="'$(Oc2AudioDirectory)' == ''">$(MSBuildThisFileDirectory)../../build/audio/native</Oc2AudioDirectory>
    <Oc2AudioLibrary Condition="$([MSBuild]::IsOSPlatform('Windows'))">oc2_audio.dll</Oc2AudioLibrary>
    <Oc2AudioLibrary Condition="$([MSBuild]::IsOSPlatform('OSX'))">liboc2_audio.dylib</Oc2AudioLibrary>
    <Oc2AudioLibrary Condition="$([MSBuild]::IsOSPlatform('Linux'))">liboc2_audio.so</Oc2AudioLibrary>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="$(Oc2AudioDirectory)/$(Oc2AudioLibrary)" Link="$(Oc2AudioLibrary)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(Oc2AudioDirectory)/oc2-audio-build.json" Link="oc2-audio-build.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(Oc2AudioDirectory)/MINIAUDIO-LICENSE.txt" Link="MINIAUDIO-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequirePinnedAudio" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(Oc2AudioDirectory)/$(Oc2AudioLibrary)')" Text="Build native audio first: python tools/dotnet/build_audio.py" />
    <Exec Command="&quot;$(Oc2Python)&quot; &quot;$(MSBuildThisFileDirectory)../../tools/dotnet/build_audio.py&quot; --verify --output &quot;$(Oc2AudioDirectory)&quot;" />
  </Target>
  <!-- Opt in on this host only; ordinary builds retain the managed restore graph. -->
  <PropertyGroup Condition="'$(Oc2DesktopAot)' == 'true'">
    <PublishAot>true</PublishAot>
    <Oc2DesktopAotRid Condition="'$(Oc2DesktopAotRid)' == ''">$(NETCoreSdkPortableRuntimeIdentifier)</Oc2DesktopAotRid>
    <RuntimeIdentifier>$(Oc2DesktopAotRid)</RuntimeIdentifier>
    <NuGetLockFilePath>$(MSBuildThisFileDirectory)../../packaging/locks/desktop-aot/$(RuntimeIdentifier).json</NuGetLockFilePath>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Avalonia.Desktop" /><ProjectReference Include="../OpenCiv2.App/OpenCiv2.App.csproj" /><ProjectReference Include="../OpenCiv2.IO.Native/OpenCiv2.IO.Native.csproj" /><ProjectReference Include="../OpenCiv2.Platform.Native/OpenCiv2.Platform.Native.csproj" /></ItemGroup>
</Project>
